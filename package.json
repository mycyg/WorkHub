{
  "name": "workhub",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "node -e \"const fs=require('fs');if(!fs.existsSync('scripts/dev/install-git-hooks.mjs'))process.exit(0);const r=require('child_process').spawnSync(process.execPath,['scripts/dev/install-git-hooks.mjs'],{stdio:'inherit'});process.exit(r.status??1)\"",
    "dev": "pnpm --filter @workhub/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm audit:agent-notes && pnpm audit:copy-terms && pnpm audit:portable-config && pnpm audit:target-paths && pnpm audit:migrations && pnpm audit:desktop-version && pnpm qa:r2-release-gate && pnpm qa:r4-rust-system-i18n && pnpm qa:cuu-r3-launcher-smoke && pnpm qa:cuu-r3-dev-server-smoke && pnpm qa:cuu-r3-run-stream-smoke && pnpm qa:cuu-r3-run-failure-smoke && pnpm qa:cuu-r3-reload-restore-smoke && pnpm qa:cuu-r3-error-fault-smoke && pnpm audit:third-party-notices",
    "verify": "pnpm typecheck && pnpm test && pnpm lint",
    "qa:r1-route-visual": "tsx scripts/qa/r1-route-visual-qa.ts",
    "qa:r4-web-route-state-matrix": "tsx scripts/qa/r4-web-route-state-matrix.ts",
    "qa:r4-web-route-registry-loader": "tsx --tsconfig apps/web/tsconfig.json scripts/qa/r4-web-route-registry-loader.ts",
    "qa:r4-web-multi-record-page-vm": "tsx --tsconfig apps/web/tsconfig.json scripts/qa/r4-web-multi-record-page-vm.ts",
    "qa:r4-web-product-shell-baseline": "tsx --tsconfig apps/web/tsconfig.json scripts/qa/r4-web-product-shell-baseline.ts",
    "qa:r4-web-live-route-interaction": "pnpm --filter @workhub/web qa:r4-live-route-interaction",
    "qa:r4-web-live-api-pg-seed": "pnpm --filter @workhub/web qa:r4-live-api-pg-seed",
    "qa:r4-web-redis-sse-browser-smoke": "pnpm --filter @workhub/web qa:r4-redis-sse-browser-smoke",
    "qa:r4-web-locale-metrics-browser-smoke": "pnpm --filter @workhub/web qa:r4-locale-metrics-browser-smoke",
    "qa:r4-rust-system-i18n": "tsx scripts/qa/r4-rust-system-i18n.ts",
    "qa:cuu-pet-run-card-overflow": "tsx scripts/qa/cuu-pet-run-card-overflow-qa.ts",
    "qa:r2-release-gate": "tsx scripts/qa/r2-release-gate-report.ts",
    "qa:cuu-r3-launcher-smoke": "pnpm --filter @workhub/api qa:cuu-r3-launcher-smoke",
    "qa:cuu-r3-dev-server-smoke": "pnpm --filter @workhub/api qa:cuu-r3-dev-server-smoke",
    "qa:cuu-r3-run-stream-smoke": "pnpm --filter @workhub/api qa:cuu-r3-run-stream-smoke",
    "qa:cuu-r3-run-failure-smoke": "pnpm --filter @workhub/api qa:cuu-r3-run-failure-smoke",
    "qa:cuu-r3-reload-restore-smoke": "pnpm --filter @workhub/api qa:cuu-r3-reload-restore-smoke",
    "qa:cuu-r3-error-fault-smoke": "pnpm --filter @workhub/api qa:cuu-r3-error-fault-smoke",
    "audit:portable-config": "tsx scripts/dev/check-portable-config.ts",
    "audit:target-paths": "tsx scripts/dev/check-target-paths.ts",
    "audit:migrations": "tsx scripts/dev/check-migrations.ts",
    "qa:r1-pg-smoke": "pnpm --filter @workhub/api qa:r1-pg-smoke",
    "qa:plugin-smoke": "pnpm --filter @workhub/api qa:plugin-smoke",
    "qa:r5-10-dry": "pnpm --filter @workhub/api qa:r5-10-dry",
    "qa:r5-10-real": "pnpm --filter @workhub/api qa:r5-10-real",
    "qa:r2-pg-redis-smoke": "pnpm --filter @workhub/api qa:r2-pg-redis-smoke",
    "build:desktop-macos": "bash scripts/dev/build-macos-app.sh",
    "build:desktop": "cd client-tauri/src-tauri && cargo tauri build",
    "qa:desktop-macos-codesign-smoke": "WORKHUB_MACOS_BUILD_SKIP_BUILD=1 bash scripts/dev/build-macos-app.sh",
    "db:generate": "pnpm --filter @workhub/db generate",
    "db:migrate": "pnpm --filter @workhub/db migrate",
    "db:check": "pnpm --filter @workhub/db check",
    "audit:agent-notes": "tsx scripts/dev/check-agent-notes.ts",
    "audit:copy-terms": "tsx scripts/dev/check-copy-terms.ts",
    "audit:desktop-version": "tsx scripts/dev/check-desktop-version.ts",
    "sync:desktop-version": "tsx scripts/dev/sync-desktop-version.ts",
    "audit:third-party-notices": "tsx scripts/dev/gen-third-party-notices.ts --check",
    "gen:third-party-notices": "tsx scripts/dev/gen-third-party-notices.ts",
    "release:desktop": "bash scripts/dev/release-desktop.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "lefthook": "^2.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
