{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkHub",
  "version": "0.1.0",
  "identifier": "com.mycyg.workhub",
  "build": {
    "beforeDevCommand": "pnpm --filter @workhub/desktop-webview dev -- --port 1420",
    "beforeBuildCommand": "pnpm --filter @workhub/desktop-webview build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../apps/desktop-webview/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss: ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "WorkHub",
        "url": "/",
        "width": 720,
        "height": 64,
        "minWidth": 420,
        "minHeight": 48,
        "resizable": true,
        "visible": true,
        "focus": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false
      },
      {
        "label": "pet",
        "title": "Cuu",
        "url": "/pet.html",
        "create": false,
        "width": 260,
        "height": 340,
        "minWidth": 220,
        "minHeight": 300,
        "resizable": false,
        "visible": false,
        "focus": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["workhub", "yqgl"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
