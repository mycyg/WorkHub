# WorkHub pilot 环境配置模板。复制为 .env.pilot 后按注释填写。
# 用法：cp .env.pilot.example .env.pilot && 编辑 → docker compose -f docker-compose.pilot.yml up -d --build

# ===== 必填（安全） =====
# 会话 cookie 签名密钥：生产必须是强随机串（生成：openssl rand -hex 32）。
COOKIE_SECRET=please-generate-a-strong-random-secret
# 管理员口令：第一个用户在注册屏展开"我是管理员"并填它来认领 admin。
ADMIN_CLAIM_SECRET=please-set-an-admin-passphrase

# ===== 必填（基础） =====
# 浏览器访问地址不是 https 时保持 false（LAN 内常见）。
COOKIE_SECURE=false
# LAN 内允许的来源；用具体地址替换（如 http://192.168.1.10:8787）。
CORS_ALLOW_ORIGINS=*

# ===== 数据库口令（与 compose 内 postgres 服务联动） =====
POSTGRES_PASSWORD=workhub

# ===== AI 工人（R5.10 真 key 验证时填） =====
# DeepSeek（Anthropic 协议端点）默认配置已内置，只需填 key：
LLM_API_KEY=
# 或自定义端点/模型：
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# LLM_MODEL=deepseek-v4-flash
# LLM_MAX_TOKENS_PER_STEP=8192

# ===== 可选 =====
# 对外端口（默认 8787）。
# WORKHUB_PORT=8787
# 日志格式：json（默认，便于采集）或 pretty（人读）。
# LOG_FORMAT=json
# 多 worker（pilot 单机默认 1；调大前先读 r2-release-gate.md）。
# WORKER_COUNT=1
