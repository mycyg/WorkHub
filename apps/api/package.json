{
  "name": "@workhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@workhub/agent": "workspace:*",
    "@workhub/config": "workspace:*",
    "@workhub/contracts": "workspace:*",
    "@workhub/audit": "workspace:*",
    "@workhub/db": "workspace:*",
    "@workhub/events": "workspace:*",
    "@workhub/permissions": "workspace:*",
    "hono": "^4.8.0",
    "redis": "^5.5.6",
    "zod": "^4.0.1"
  }
}
