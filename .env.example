# WorkHub local development settings.
# Copy to .env and fill real secrets locally. Do not commit .env files.
# Every key here mirrors packages/config/src/env.ts — that file is the source of truth if this drifts.

# ===== App runtime =====
APP_ENV=development
PORT=8787
API_HOST=127.0.0.1
# In-process worker pool size for one API instance. See "single-instance assumption" in DEPLOY.md
# before raising this or running multiple containers/replicas of the API.
WORKER_COUNT=1
# json (default, machine-parseable for log collectors) or pretty (human-readable, for local dev).
LOG_FORMAT=json
# Optional cap on JSON request body size in bytes; defaults to 1048576 (1 MiB) when unset or invalid.
# Read directly by apps/api/src/app.ts, not part of the zod schema below.
# MAX_REQUEST_BODY_BYTES=1048576

# ===== Database =====
DATABASE_URL=postgresql+psycopg://workhub:workhub@127.0.0.1:5432/workhub
DATA_DIR=./data
DOWNLOADS_DIR=
WEB_DIST_DIR=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ===== Queue / broker =====
# memory = single process only, state lives in this process's RAM (fine for local dev and a
# single-container pilot deploy). redis = required once WORKER_COUNT > 1 or you run more than one
# API container/replica. See "single-instance assumption" in DEPLOY.md.
BROKER_BACKEND=memory
BROKER_URL=

# ===== Auth / cookies =====
COOKIE_SECRET=dev-change-me
COOKIE_SECURE=false
ADMIN_CLAIM_SECRET=
CORS_ALLOW_ORIGINS=*
TOUCH_DEVICE_ON_AUTH=true
DEFAULT_ORG_ID=00000000-0000-4000-8000-000000000001
DEFAULT_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# Auth mode: nickname (default; LAN-trust, no password, cookie carries a plain user token) |
# hybrid (server-side session cookie, falls back to nickname if it can't be resolved — migration
# aid) | password (server-side session cookie only).
AUTH_MODE=nickname
# Session lifetime in hours. Absolute = hard cap since login regardless of activity (default 720h
# = 30 days); idle = session expires after this much inactivity (default 168h = 7 days).
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_IDLE_TTL_HOURS=168

# GitHub integration: master key for encrypting project GitHub PATs at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   (must decode to exactly 32 bytes)
# Leave empty to keep the GitHub integration disabled (binding endpoints fail closed with 503,
# nothing is ever stored in plaintext).
GITHUB_TOKEN_ENC_KEY=
# How many days without any repo activity (commit / PR / issue) counts as "the repo has gone quiet".
# The daily risk digest calls that out for projects that have a repo bound. 1-90, default 7.
GITHUB_STALE_DAYS=7

# ===== LLM provider =====
# Leave LLM_API_KEY empty to run without an AI worker: the rest of the product (chat, work items,
# approvals, drive, dashboards) still works, but Cuu will not observe or reply, and the composer
# shows an "AI not configured" banner. See DEPLOY.md.
LLM_PROVIDER_DEFAULT=deepseek
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
# Max output tokens the agent loop requests per step (hard ceiling 64000).
LLM_MAX_TOKENS_PER_STEP=8192

PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Optional override; falls back to LLM_MODEL when unset.
# PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash
PROVIDER_DEEPSEEK_COST_INPUT_CNY_PER_MTOK=2
PROVIDER_DEEPSEEK_COST_OUTPUT_CNY_PER_MTOK=8

# ===== Budgets (CNY cost / token counts) =====
BUDGET_DEFAULT_RUN_TOKENS=120000
BUDGET_DEFAULT_USER_DAILY_TOKENS=500000
BUDGET_DEFAULT_TEAM_DAILY_TOKENS=5000000
BUDGET_DEFAULT_TEAM_MONTHLY_TOKENS=50000000
# Nightly/release eval-suite daily token budget; keeps a misconfigured or runaway suite from
# burning unlimited tokens (the eval tier previously had no ceiling at all).
BUDGET_DEFAULT_EVAL_DAILY_TOKENS=2000000
BUDGET_DEFAULT_RUN_COST_CNY=5
# Default total budget for a multi-agent task plan; split across child runs by budget_share_pct.
BUDGET_DEFAULT_TASK_PLAN_COST_CNY=10
BUDGET_DEFAULT_USER_DAILY_COST_CNY=20
BUDGET_DEFAULT_TEAM_DAILY_COST_CNY=200
BUDGET_DEFAULT_TEAM_MONTHLY_COST_CNY=2000
BUDGET_DEFAULT_EVAL_DAILY_COST_CNY=80
# Nightly skill-curation daily cost cap; curation is skipped for the rest of the day once hit.
BUDGET_DEFAULT_CURATION_DAILY_COST_CNY=40

# ===== Agent run engine =====
# Lease duration for a claimed AgentRun before it's considered stuck and recovered, in ms.
AGENT_RUN_LEASE_MS=300000
# 0 disables heartbeat pinging; set a positive interval (ms) if you route through a provider with
# long-running individual calls and want liveness pings during a single step.
AGENT_RUN_HEARTBEAT_INTERVAL_MS=0
# How often the recovery sweep looks for stuck runs, in ms.
AGENT_RUN_RECOVERY_INTERVAL_MS=30000
# Max times a stuck run is requeued before it's marked failed instead of retried forever.
AGENT_RUN_MAX_RECOVER_ATTEMPTS=3
# fail-closed by default: unsandboxed command execution (the agent's run_command tool running
# python/node/pytest etc. to produce Word/Excel/PPT/charts/scripts) is NOT process-isolated and can
# read arbitrary host paths. Only set true on a single trusted machine/LAN pilot deployment; keep
# false for any multi-tenant or public deployment and inject a genuinely isolated runner instead.
AGENT_RUN_ALLOW_UNSANDBOXED_COMMANDS=false
# Nightly team-skill self-iteration (idle-time distillation); off by default, opt in once you want
# it running unattended.
AGENT_RUN_SKILL_CURATION_ENABLED=false
AGENT_RUN_SKILL_CURATION_INTERVAL_MS=86400000
AGENT_RUN_PROJECT_HYDRATE_ENABLED=true
AGENT_RUN_PROJECT_HYDRATE_MAX_FILES=200
AGENT_RUN_PROJECT_HYDRATE_MAX_BYTES=33554432
