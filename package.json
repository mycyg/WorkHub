{
  "name": "workhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @workhub/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm audit:portable-config && pnpm audit:target-paths && pnpm audit:migrations && pnpm qa:r2-release-gate && pnpm qa:cuu-r3-launcher-smoke && pnpm qa:cuu-r3-dev-server-smoke && pnpm qa:cuu-r3-run-stream-smoke && pnpm qa:cuu-r3-run-failure-smoke && pnpm qa:cuu-r3-reload-restore-smoke && pnpm qa:cuu-r3-error-fault-smoke",
    "verify": "pnpm typecheck && pnpm test && pnpm lint",
    "qa:r1-route-visual": "tsx scripts/qa/r1-route-visual-qa.ts",
    "qa:r4-web-route-state-matrix": "tsx scripts/qa/r4-web-route-state-matrix.ts",
    "qa:r4-web-route-registry-loader": "tsx --tsconfig apps/web/tsconfig.json scripts/qa/r4-web-route-registry-loader.ts",
    "qa:r4-web-multi-record-page-vm": "tsx --tsconfig apps/web/tsconfig.json scripts/qa/r4-web-multi-record-page-vm.ts",
    "qa:cuu-pet-run-card-overflow": "tsx scripts/qa/cuu-pet-run-card-overflow-qa.ts",
    "qa:r2-release-gate": "tsx scripts/qa/r2-release-gate-report.ts",
    "qa:cuu-r3-launcher-smoke": "pnpm --filter @workhub/api qa:cuu-r3-launcher-smoke",
    "qa:cuu-r3-dev-server-smoke": "pnpm --filter @workhub/api qa:cuu-r3-dev-server-smoke",
    "qa:cuu-r3-run-stream-smoke": "pnpm --filter @workhub/api qa:cuu-r3-run-stream-smoke",
    "qa:cuu-r3-run-failure-smoke": "pnpm --filter @workhub/api qa:cuu-r3-run-failure-smoke",
    "qa:cuu-r3-reload-restore-smoke": "pnpm --filter @workhub/api qa:cuu-r3-reload-restore-smoke",
    "qa:cuu-r3-error-fault-smoke": "pnpm --filter @workhub/api qa:cuu-r3-error-fault-smoke",
    "audit:portable-config": "tsx scripts/dev/check-portable-config.ts",
    "audit:target-paths": "tsx scripts/dev/check-target-paths.ts",
    "audit:migrations": "tsx scripts/dev/check-migrations.ts",
    "qa:r1-pg-smoke": "pnpm --filter @workhub/api qa:r1-pg-smoke",
    "qa:r2-pg-redis-smoke": "pnpm --filter @workhub/api qa:r2-pg-redis-smoke",
    "db:generate": "pnpm --filter @workhub/db generate",
    "db:migrate": "pnpm --filter @workhub/db migrate",
    "db:check": "pnpm --filter @workhub/db check"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
