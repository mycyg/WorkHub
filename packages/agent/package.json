    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "import": "./src/providers/index.ts"
    },
    "./loop": {
      "types": "./src/loop/index.ts",
      "import": "./src/loop/index.ts"
    },
    "./loop2": {
      "types": "./src/loop2/index.ts",
      "import": "./src/loop2/index.ts"
    },
    "./deliverables": {
      "types": "./src/deliverables/index.ts",
      "import": "./src/deliverables/index.ts"
    },
    "./evaluation": {
      "types": "./src/evaluation/index.ts",
      "import": "./src/evaluation/index.ts"
    },
    "./observer": {
      "types": "./src/observer/index.ts",
