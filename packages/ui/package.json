      "import": "./src/gold-path/index.ts"
    },
    "./intake": {
      "types": "./src/intake/index.ts",
      "import": "./src/intake/index.ts"
    },
    "./workitem": {
      "types": "./src/workitem/index.ts",
      "import": "./src/workitem/index.ts"
    },
    "./agent-run": {
      "types": "./src/agent-run/index.ts",
