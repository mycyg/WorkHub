{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@workhub/config": ["packages/config/src/index.ts"],
      "@workhub/contracts": ["packages/contracts/src/index.ts"],
      "@workhub/api-client": ["packages/api-client/src/index.ts"],
      "@workhub/cost": ["packages/cost/src/index.ts"],
      "@workhub/audit": ["packages/audit/src/index.ts"],
      "@workhub/agent": ["packages/agent/src/index.ts"],
      "@workhub/agent/loop": ["packages/agent/src/loop/index.ts"],
      "@workhub/agent/providers": ["packages/agent/src/providers/index.ts"],
      "@workhub/tools": ["packages/tools/src/index.ts"],
      "@workhub/db": ["packages/db/src/index.ts"],
      "@workhub/db/schema": ["packages/db/src/schema/index.ts"],
      "@workhub/events": ["packages/events/src/index.ts"],
      "@workhub/permissions": ["packages/permissions/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
