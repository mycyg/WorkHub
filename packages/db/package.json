{
  "name": "@workhub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx src/migrate.ts",
    "check": "drizzle-kit check --config drizzle.config.ts"
  },
  "dependencies": {
    "@workhub/contracts": "workspace:*",
    "@workhub/config": "workspace:*",
    "@workhub/cost": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.5"
  }
}
